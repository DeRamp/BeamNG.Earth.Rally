{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "crossSessionInbound": "accept",
  "permissions": {
    "allow": [
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr merge *)",
      "Bash(gh auth status*)",
      "Bash(git worktree add --detach .claude/worktrees/maintainer-review *)",
      "Bash(git -C .claude/worktrees/maintainer-review *)",
      "Bash(gh api -X DELETE repos/DeRamp/BeamNG.Earth.Rally/git/refs/heads/*)",
      "Bash(git pull --ff-only*)",
      "Bash(git symbolic-ref *)",
      "Bash(python tests/run_tests.py *)",
      "Bash(cd .claude/worktrees/maintainer-review && python tests/run_tests.py *)",
      "Bash(python tools/release.py *)",
      "Bash(cd .claude/worktrees/maintainer-review && python tools/release.py *)"
    ]
  }
}
